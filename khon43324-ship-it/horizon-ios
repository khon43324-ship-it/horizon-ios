workflows:
  ios-horizon-build:
    name: Horizon iOS Client Build
    max_build_duration: 30
    instance_type: mac_mini_m1 # Sử dụng máy ảo Mac để dễ xử lý môi trường Apple
    environment:
      groups:
        - target-env
      vars:
        JAVA_VERSION: "25" # Yêu cầu máy ảo kích hoạt Java 25
      xcode: latest
      cocoapods: default
    triggering:
      events:
        - push
    scripts:
      - name: Install Rust and iOS Target
        script: |
          curl --proto '=https' --tlv1.2 -sSf https://rustup.rs | sh -s -- -y
          source $HOME/.cargo/env
          rustup target add aarch64-apple-ios
      - name: Prepare Assets (Requires Java 25 and Python)
        script: |
          source $HOME/.cargo/env
          # Cần chạy lệnh tải/chuẩn bị asset của Horizon ở đây
          cargo run --release -p horizon-prepare -- --prepare
      - name: Build Rust iOS Client
        script: |
          source $HOME/.cargo/env
          cargo build --release --target aarch64-apple-ios -p horizon-client
      - name: Package IPA for TrollStore
        script: |
          mkdir -p Payload
          # Copy file binary vừa build xong vào Payload
          cp target/aarch64-apple-ios/release/horizon-client Payload/
          
          # Tự động tạo file Info.plist nhanh trên máy ảo
          cat <<EOF > Payload/Info.plist
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
          <plist version="1.0">
          <dict>
              <key>CFBundleDevelopmentRegion</key>
              <string>en</string>
              <key>CFBundleExecutable</key>
              <string>horizon-client</string>
              <key>CFBundleIdentifier</key>
              <string>com.heyskylo.horizonios</string>
              <key>CFBundleName</key>
              <string>HorizonRust</string>
              <key>CFBundlePackageType</key>
              <string>APPL</string>
              <key>CFBundleShortVersionString</key>
              <string>1.0</string>
              <key>CFBundleVersion</key>
              <string>1</string>
              <key>MinimumOSVersion</key>
              <string>15.0</string>
          </dict>
          </plist>
          EOF
          
          # Nén thành file .ipa hoàn chỉnh
          zip -r HorizonMinecraft.ipa Payload
    artifacts:
      - HorizonMinecraft.ipa # Chỉ định Codemagic giữ lại file này sau khi build xong
